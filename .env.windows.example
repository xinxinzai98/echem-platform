# Windows Docker Desktop 部署模板。复制为 .env 后再启动。
ECHEM_LAN_IP=192.168.110.225
ECHEM_LAN_BIND=0.0.0.0
ECHEM_LOCAL_PORT=18787
ECHEM_LAN_PORT=18788
ECHEM_LAN_AUTH_FILE=./state/docker/secrets/lan-basic-auth.txt
ECHEM_SSH_DIR=C:/StartStopAnalysis/secrets/ssh

ECHEM_IMAGE_REPOSITORY=start-stop-analysis
ECHEM_IMAGE_VERSION=0.6.0-dev.7.2
ECHEM_IMAGE_TAG=0.6.0-dev.7.2-windows
ECHEM_IMAGE_TAG_FROM_GIT=0
ECHEM_SQLITE_JOURNAL_MODE=DELETE

ECHEM_LOCAL_CPU_LIMIT=4.0
ECHEM_LOCAL_MEMORY_LIMIT=8g
ECHEM_LOCAL_PIDS_LIMIT=512
ECHEM_LOCAL_SCRATCH_SIZE=4g
ECHEM_LOCAL_TMP_SIZE=256m
ECHEM_LOCAL_CACHE_SIZE=128m
ECHEM_LAN_CPU_LIMIT=1.0
ECHEM_LAN_MEMORY_LIMIT=1g
ECHEM_LAN_PIDS_LIMIT=128
ECHEM_LAN_TMP_SIZE=256m
ECHEM_LAN_CACHE_SIZE=64m
ECHEM_STOP_GRACE_PERIOD=90s

ECHEM_LOG_MAX_SIZE=10m
ECHEM_LOG_MAX_FILES=5
ECHEM_HEALTHCHECK_INTERVAL=60s
ECHEM_HEALTHCHECK_TIMEOUT=5s
ECHEM_HEALTHCHECK_RETRIES=3
ECHEM_HEALTHCHECK_START_PERIOD=30s
ECHEM_BACKUP_DIR=./state/docker/backups
ECHEM_BACKUP_STATUS_VOLUME_NAME=start-stop-analysis-backup-status
ECHEM_BACKUP_CPU_LIMIT=1.0
ECHEM_BACKUP_MEMORY_LIMIT=512m
ECHEM_BACKUP_PIDS_LIMIT=64
ECHEM_BACKUP_SCHEDULE_ANCHOR=2026-08-30T03:00:00+08:00
ECHEM_BACKUP_SCHEDULE_ENABLED=1
ECHEM_BACKUP_SCHEDULE_LABEL=每 4 周周日 03:00 后台执行
ECHEM_PUBLISHED_DIR=./state/docker/published
ECHEM_DATABASE_VOLUME_NAME=start-stop-analysis-database
